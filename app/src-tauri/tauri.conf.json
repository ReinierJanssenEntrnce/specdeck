{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpecDeck",
  "version": "1.0.0",
  "identifier": "com.entrnce.specdeck",
  "build": {
    "beforeDevCommand": "pnpm --filter @specdeck/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @specdeck/ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
